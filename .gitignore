# Local Python environment and tool state
.venv/
.uv-cache/
.python-version
.serena/

# Generated simulation outputs and MuJoCo runtime files
out/
build/
frames/
models/
artifacts/
*.mp4
*.png
MUJOCO_LOG.TXT

# Captured dataset: large, and it belongs in shared storage rather than git.
# Layout is documented in docs/DATASET.md.
data/

# Trained weights
*.pt
*.onnx
*.tflite

# The robot model is a sparse checkout fetched by scripts/bootstrap_model.sh.
# Keep it local rather than committing a nested Git repository.
mujoco_menagerie/
vendor/mujoco_menagerie/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# Previous camera.toml versions kept by `camera tune`; camera.toml itself is committed.
camera.*.toml.bak
